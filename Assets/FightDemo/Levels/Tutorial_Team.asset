%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 389a2cd22911954408b91d7bc204aefd, type: 3}
  m_Name: Tutorial_Team
  m_EditorClassIdentifier: Assembly-CSharp::RhythmHunter.FightDemo.FightTutorialLesson
  controlEnemyAttacks: 1
  preventPlayerDeath: 1
  preventEnemyDeath: 1
  allowAllHeroCommands: 1
  attackInFreePractice: 0
  enemyAttackIntervalBeats: 4
  steps:
  - title: "團隊練習"
    text: "三位勇者一起上場！\n<b><color=#FFD879>X：戰士　Y：法師　B：遊俠</color></b>\n完成三個目標，練習交替呼喚隊友。"
    goal: 0
    required: 1
    allowSwordCharge: 1
    allowEnemyAttacks: 0
    suppressMageRetaliation: 0
  - title: "戰士充能攻擊"
    text: "對拍按 <b><color=#FFD879>X</color></b>，累積命中 <b><color=#FFD879>5 次充能攻擊</color></b>。"
    goal: 3
    required: 5
    allowSwordCharge: 1
    allowEnemyAttacks: 0
    suppressMageRetaliation: 0
  - title: "練習防禦"
    text: "哥布林即將開始攻擊。\n觀察警告，對拍按 <b><color=#FFD879>Y</color></b>，呼喚法師施放護盾，<b><color=#FFD879>格擋一次傷害</color></b>！"
    goal: 0
    required: 1
    allowSwordCharge: 1
    allowEnemyAttacks: 0
    suppressMageRetaliation: 0
  - title: "格擋敵人攻擊"
    text: "對拍按 <b><color=#FFD879>Y</color></b>，<b><color=#FFD879>成功格擋 3 次</color></b>。"
    goal: 5
    required: 3
    allowSwordCharge: 1
    allowEnemyAttacks: 1
    suppressMageRetaliation: 0
  - title: "遊俠-死亡比利"
    text: "連續兩拍按 <b><color=#FFD879>B</color></b>，射擊並<b><color=#FFD879>標記敵人</color></b>。\n標記期間，呼喚戰士攻擊，讓比利<b><color=#FFD879>同步追擊</color></b>！"
    goal: 0
    required: 1
    allowSwordCharge: 1
    allowEnemyAttacks: 0
    suppressMageRetaliation: 0
  - title: "觸發遊俠追擊"
    text: "連續兩拍按 <b><color=#FFD879>B</color></b> 標記，再按 <b><color=#FFD879>X</color></b> 攻擊。\n累積命中 <b><color=#FFD879>4 次追擊</color></b>。"
    goal: 7
    required: 4
    allowSwordCharge: 1
    allowEnemyAttacks: 0
    suppressMageRetaliation: 0
  - title: "訓練完成！"
    text: "自由練習，或按 <b><color=#FFD879>RB</color></b> 進入下一關教學。"
    goal: 4
    required: 1
    allowSwordCharge: 1
    allowEnemyAttacks: 0
    suppressMageRetaliation: 0
