  steps:
  - title: "遊俠－死亡比利"
    text: "連續兩拍按下 <b><color=#FFD879>X</color></b>，先瞄準，再射擊！"
    goal: 0
    required: 1
    allowSwordCharge: 0
    allowEnemyAttacks: 0
    suppressMageRetaliation: 0
  - title: "練習瞄準射擊"
    text: "連續兩拍按 <b><color=#FFD879>X</color></b>，完成 <b><color=#FFD879>3 次射擊</color></b>。"
    goal: 8
    required: 3
    allowSwordCharge: 0
    allowEnemyAttacks: 0
    suppressMageRetaliation: 0
  - title: "遊俠－死亡比利"
    text: "<b>技能：追擊</b>\n\n射擊會<b><color=#FFD879>標記敵人</color></b>，隊友攻擊時，比利會<b><color=#FFD879>同步追擊</color></b>！"
    goal: 0
    required: 1
    allowSwordCharge: 0
    allowEnemyAttacks: 0
    suppressMageRetaliation: 0
  - title: "練習維持標記"
    text: "再次射擊，<b><color=#FFD879>刷新標記 3 次</color></b>。"
    goal: 9
    required: 3
    allowSwordCharge: 0
    allowEnemyAttacks: 0
    suppressMageRetaliation: 0
  - title: "訓練完成！"
    text: "自由練習，或按 <b><color=#FFD879>RB</color></b> 進入下一關教學。"
    goal: 4
    required: 1
    allowSwordCharge: 0
    allowEnemyAttacks: 0
    suppressMageRetaliation: 0
