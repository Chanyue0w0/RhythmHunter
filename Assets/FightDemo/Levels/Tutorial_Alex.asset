  m_Script: {fileID: 11500000, guid: 389a2cd22911954408b91d7bc204aefd, type: 3}
  m_Name: Tutorial_Alex
  m_EditorClassIdentifier: Assembly-CSharp::RhythmHunter.FightDemo.FightTutorialLesson
  steps:
  - title: "\u6B61\u8FCE\u4F86\u5230\u300A\u5C0D\u62CD\u52C7\u8005\u300B"
    text: "\u672C\u6559\u5B78\u4F7F\u7528 <b><color=#FFD879>Xbox \u6416\u687F</color></b>\u3002\n\u8DDF\u8457\u97F3\u6A02\u7BC0\u594F\uFF0C\u547C\u559A\u52C7\u8005\u4E00\u8D77\u6230\u9B25\u5427\uFF01"
    goal: 0
    required: 1
    allowSwordCharge: 0
  - title: "\u5148\u5B78\u6703\u5C0D\u62CD"
    text: "\u7576\u62CD\u9EDE\u5F80\u4E2D\u9593\u5BF6\u77F3\u63A5\u8FD1\u6642\uFF0C\n\u5C0D\u62CD\u6309\u4E0B
      <b><color=#FFD879>X</color></b>\uFF0C\u8B93\u52C7\u8005\u8DF3\u8D77\u4F86\uFF01"
    goal: 0
    required: 1
    allowSwordCharge: 0
  - title: "\u5C0D\u62CD\u547C\u559A\u52C7\u8005"
    text: "\u5C0D\u62CD\u6309 <b><color=#FFD879>X</color></b>\u3002"
    goal: 1
    required: 8
    allowSwordCharge: 0
  - title: "做得好！"
    text: "這隻角色是「<b><color=#FFD879>戰士-艾力克斯</color></b>」\n\n對拍按下 <b><color=#FFD879>X</color></b>，揮劍攻擊<b><color=#FFD879>最前方的敵人</color></b>！"
    goal: 0
    required: 1
    allowSwordCharge: 0
  - title: "\u666E\u901A\u653B\u64CA\u547D\u4E2D"
    text: "\u5C0D\u62CD\u6309 <b><color=#FFD879>X</color></b>\uFF0C\u653B\u64CA\u5047\u4EBA\u3002"
    goal: 2
    required: 4
    allowSwordCharge: 0
  - title: "戰士-艾力克斯"
    text: "<b>技能： 節拍共振</b>\n\n攻擊可以<b><color=#FFD879>充能</color></b>，滿能量時斬擊更強，並造成<b><color=#FFD879>追加傷害</color></b>！"
    goal: 0
    required: 1
    allowSwordCharge: 1
  - title: "\u5171\u632F\u653B\u64CA\u547D\u4E2D"
    text: "\u6301\u7E8C\u5C0D\u62CD\u653B\u64CA\uFF0C\u4F7F\u51FA\u5F37\u5316\u65AC\u64CA\u3002"
    goal: 3
    required: 8
    allowSwordCharge: 1
  - title: "\u8A13\u7DF4\u5B8C\u6210\uFF01"
    text: "\u81EA\u7531\u7DF4\u7FD2\uFF0C\u6216\u6309 <b><color=#FFD879>RB</color></b>
      \u9032\u5165\u4E0B\u4E00\u95DC\u6559\u5B78\u3002"
    goal: 4
    required: 1
    allowSwordCharge: 1
